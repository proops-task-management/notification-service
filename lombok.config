# Lombok stamps every generated method (getters/setters/builders/equals/hashCode) with
# @lombok.Generated, which JaCoCo excludes from coverage by default. Without this, generated
# POJO code (e.g. the ProcessedEvent entity) counts as untested "new code" and drags the
# SonarCloud new-code coverage gate below 80% (D8/MIN-12). See TSG-015.
lombok.addLombokGeneratedAnnotation = true

# This is the root for lombok config in the service — stop searching parent directories.
config.stopBubbling = true
